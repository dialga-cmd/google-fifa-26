# FanWayfinder environment configuration — EXAMPLE
#
# Copy this file to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
#
# In production, set these as platform environment variables (e.g. in the
# Render dashboard) instead of shipping a .env file. NEVER commit real secrets.
#
# Every value below is optional and falls back to the shown default EXCEPT
# SECRET_KEY, which is required when ENVIRONMENT=production (the app refuses to
# start otherwise). The defaults shown for non-secret vars mirror src/config.py.

# ── Runtime mode ─────────────────────────────────────────────────────────────
# "development" (default) or "production". In production the app fails fast at
# startup unless SECRET_KEY below is set to a strong, unique value.
ENVIRONMENT=development

# ── AI provider keys ─────────────────────────────────────────────────────────
# Needed for live advice generation. AI_PROVIDER=auto uses whichever key is set.
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
AI_PROVIDER=auto

# ── Security / JWT ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate a strong value with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
# Optional backend store for rate-limit counters (e.g. redis://localhost:6379).
# Unset = in-memory counters (per-process; fine for dev, not multi-worker prod).
SLOWAPI_STORAGE_URI=

# ── Redis (advice cache) ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave blank if your Redis instance has no password.
REDIS_PASSWORD=

# ── MQTT (live congestion feed) ──────────────────────────────────────────────
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=stadium/congestion/edge/#

# ── Data files ───────────────────────────────────────────────────────────────
KB_FILE=data/kb_chunks.json
GRAPH_FILE=data/stadium_graph.gexf

# ── App tunables ─────────────────────────────────────────────────────────────
DEFAULT_LOCATION=Gate_A
MAX_QUERY_LENGTH=200
CACHE_SIZE=128
