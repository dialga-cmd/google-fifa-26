# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv
env/
ENV/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.coverage.*
*.cover
# coverage annotate output uses a comma suffix (e.g. api.py,cover), which *.cover above does NOT match
*,cover

# Backup files (editor/manual .backup copies)
*.backup

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Packaging/build artifacts
build/
dist/
*.egg-info/
.eggs/

# Environment files
.env
.env.*
# ...but keep the committed placeholder template trackable
!.env.example

# IDE/editor settings
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
